{
  "name": "syptek",
  "productName": "Syptek",
  "version": "0.1.0",
  "description": "Syptek, browser ringan berbasis Chromium (Electron) dengan ad blocker dan DNS kustom",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . Syptek --platform=win32 --arch=x64 --out=dist --overwrite --ignore=\"^/dist($|/)\" --icon=icon.ico --win32metadata.ProductName=Syptek --win32metadata.FileDescription=Syptek --win32metadata.InternalName=Syptek --win32metadata.OriginalFilename=Syptek.exe --win32metadata.CompanyName=\"RIOT REVENGER\" --app-copyright=\"Copyright (c) RIOT REVENGER\""
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.18.2",
    "@ghostery/adblocker-electron": "^2.18.2"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "@electron/packager": "^20.3.0"
  },
  "author": "RIOT REVENGER",
  "license": "MIT"
}
